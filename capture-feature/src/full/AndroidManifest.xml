<?xml version="1.0" encoding="utf-8"?>
<!-- The `full` flavour only: ARCore, optional at install (ADR 0004). The `foss` build has no ARCore and none of this. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Optional at install (ADR 0004): phones without ARCore still view, import and export. -->
    <uses-feature
        android:name="android.hardware.camera.ar"
        android:required="false" />

    <application>
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />
    </application>
</manifest>
